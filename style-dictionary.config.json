{
  "source": ["tokens/**/*.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "dist/css/",
      "files": [{ "destination": "tokens.css", "format": "css/variables" }]
    },
    "js": {
      "transformGroup": "js",
      "buildPath": "dist/js/",
      "files": [
        { "destination": "tokens.js", "format": "javascript/es6" },
        { "destination": "tokens.d.ts", "format": "typescript/es6-declarations" }
      ]
    }
  }
}
